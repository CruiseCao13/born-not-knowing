---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const posts = getSortedPosts(
  await getCollection(
    "posts",
    ({ data }) => data.category === "Music" && !data.draft
  )
);
const sections = [
  "Albums",
  "Songs",
  "Artists",
  "Listening diary",
  "Thoughts on rhythm, mood, and memory",
];
---

<Layout
  title={`Music Notes | ${config.site.title}`}
  description="Listening notes, memories, taste, and sound."
>
  <Header />
  <Main
    pageTitle="Music Notes"
    pageDesc="Listening notes, memories, taste, and sound."
  >
    <ul class="grid gap-2 sm:grid-cols-2">
      {sections.map(item => <li class="border-border border p-3">{item}</li>)}
    </ul>
    <section class="mt-10">
      <h2 class="text-xl font-semibold">Music Notes</h2>
      <ul>{posts.map(post => <Card {...post} />)}</ul>
    </section>
  </Main>
  <Footer />
</Layout>
