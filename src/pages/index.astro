---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
);
const startHereTitles = [
  "Why I Built This Site",
  "My Learning Principles",
  "How I Study Markets Without Pretending to Be an Expert",
];
const startHerePosts = startHereTitles
  .map(title => posts.find(post => post.data.title === title))
  .filter(post => post !== undefined);

const currentFocus = [
  [
    "Engineering fundamentals",
    "Systems, automation, electronics, and how physical things work.",
  ],
  [
    "English",
    "Cleaner writing, better expression, and translating thought into language.",
  ],
  [
    "Markets",
    "Business models, risk, capital allocation, and investment judgment.",
  ],
  ["Music", "Listening notes, taste, rhythm, and emotional memory."],
  ["Projects", "Small tools, experiments, and practical systems."],
];

const ledgerLinks = [
  ["Engineering", "engineering"],
  ["English", "english"],
  ["Markets", "markets"],
  ["Music", "music"],
  ["Projects", "projects"],
  ["Reflections", "reflections"],
];

const principles = [
  "Record the process before the results.",
  "Prefer clarity over performance.",
  "Make mistakes visible enough to learn from them.",
  "Separate evidence from opinion.",
  "Review old thoughts instead of worshipping them.",
  "Build slowly, but keep building.",
];
---

<Layout
  title="Born Not Knowing | Cruise Cao"
  description="Born not knowing. Learning ever since."
>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-border border-b py-12 sm:py-16">
      <p class="text-muted-foreground text-sm font-medium tracking-wide">
        Cruise Cao
      </p>
      <h1 class="mt-4 max-w-2xl text-4xl leading-tight font-bold sm:text-5xl">
        Born not knowing. Learning ever since.
      </h1>
      <p class="mt-5 text-xl font-medium">I write to think clearer.</p>
      <p class="mt-5 max-w-2xl text-lg">
        This is my public notebook on engineering, English, markets, music,
        projects, and the slow work of becoming less wrong.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <LinkButton href={getRelativeLocaleUrl(locale, "notes")}>
          Start reading
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
        <LinkButton
          href={getRelativeLocaleUrl(locale, "now")}
          class="border-border hover:border-accent border px-4 py-2"
        >
          What I’m learning now
        </LinkButton>
      </div>
      <p class="text-muted-foreground mt-5 text-sm">
        No guru. No shortcut. Just notes, experiments, mistakes, and revisions.
      </p>
      <div class="border-border bg-muted/35 mt-8 border p-4">
        <p class="text-sm">
          <span class="font-semibold">Currently studying:</span> engineering fundamentals,
          English expression, company analysis, music, and practical systems.
        </p>
      </div>
    </section>

    <section class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold">Current Focus</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          currentFocus.map(([title, description]) => (
            <article class="border-border bg-background border p-4">
              <h3 class="font-semibold">{title}</h3>
              <p class="text-muted-foreground mt-2 text-sm">{description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold">Start Here</h2>
      <div class="mt-6 grid gap-4">
        {
          startHerePosts.map(post => (
            <a
              class="border-border hover:border-accent block border p-4"
              href={getPostUrl(post.id, post.filePath, locale)}
            >
              <h3 class="text-accent font-semibold">{post.data.title}</h3>
              <p class="text-muted-foreground mt-2 text-sm">
                {post.data.description}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold">Recent Notes</h2>
      <ul>
        {posts.slice(0, 5).map(data => <Card variant="h3" {...data} />)}
      </ul>
      <div class="mt-6">
        <LinkButton href={getRelativeLocaleUrl(locale, "notes")}>
          All notes
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>

    <section class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold">Learning Ledger</h2>
      <p class="text-muted-foreground mt-3">
        A running record of what I’m studying, testing, misunderstanding,
        correcting, and slowly improving.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        {
          ledgerLinks.map(([label, href]) => (
            <a
              class="border-border hover:border-accent border px-3 py-2 text-sm"
              href={getRelativeLocaleUrl(locale, href)}
            >
              {label}
            </a>
          ))
        }
      </div>
    </section>

    <section class="py-10">
      <h2 class="text-2xl font-semibold">Principles</h2>
      <ul class="mt-5 grid gap-3">
        {
          principles.map(item => (
            <li class="border-border border-l-2 pl-4">{item}</li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
